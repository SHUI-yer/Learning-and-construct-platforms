<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learning.lpcourse.mapper.CourseAuditMapper">
    <insert id="insert">
        INSERT INTO course_audit(
            course_id,
            auditor_id,
            audit_status,
            audit_remark
        )VALUES(
                   #{courseId},
                   #{auditorId},
                   #{auditStatus},
                   #{auditRemark}
               )
    </insert>
</mapper>