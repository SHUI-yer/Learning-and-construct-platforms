<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 必须继承顶层聚合父工程 -->
	<parent>
		<groupId>com.learning</groupId>
		<artifactId>learning-platform</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>lp-auth</artifactId>
	<name>lp-auth</name>
	<description>认证授权模块：登录、五级角色、账号管理、个人信息</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- 依赖公共工具模块 -->
		<dependency>
			<groupId>com.learning</groupId>
			<artifactId>lp-common</artifactId>
		</dependency>

		<!-- Spring 基础 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<!-- Mybatis 数据库操作 -->
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
		</dependency>

		<!-- 权限安全框架 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			口令哈希（BCrypt）：只取 crypto 算法库。
			lp-starter 把 spring-boot-starter-security 整体排除了，若只依赖它，
			运行期会缺 spring-security-crypto 而抛 NoClassDefFoundError，
			因此这里显式声明，确保被排除后仍然可用。
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Lombok 实体简化 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<!-- 删除整个 build 打包插件块 -->
</project>