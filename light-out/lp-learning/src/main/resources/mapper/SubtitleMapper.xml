<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learning.learning.mapper.SubtitleMapper">
    <resultMap id="BaseResultMap" type="com.learning.learning.entity.Subtitle">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="resource_id" property="resourceId" jdbcType="BIGINT"/>
        <result column="language" property="language" jdbcType="VARCHAR"/>
        <result column="url" property="url" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectByResourceId" resultMap="BaseResultMap" parameterType="long">
        SELECT * FROM subtitle WHERE resource_id = #{resourceId} ORDER BY language ASC
    </select>
</mapper>
