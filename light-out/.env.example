# Copy to .env for local Docker Compose use. Never commit the local .env.

MYSQL_DATABASE=light_out
MYSQL_ROOT_PASSWORD=replace-me

# Variables used by the Spring Boot process when it runs outside Docker.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/light_out?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=replace-me
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-me
SPRING_DATA_REDIS_DATABASE=0
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=lp
SPRING_RABBITMQ_PASSWORD=replace-me
JWT_SECRET=replace-with-a-random-value-at-least-32-bytes
